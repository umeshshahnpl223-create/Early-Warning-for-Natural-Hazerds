        "## Part 3: Feature Engineering and Time-Based Train-Test Split\n",
        "To model this effectively and avoid data leakage:\n",
        "- We will engineer features such as planned transit hour, departure day-of-week, hour of departure, route labels, and vehicle specifications.\n",
        "- We'll sort shipments chronologically by departure time and split them into Train (first 80%) and Test (remaining 20%) datasets."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "10cfa505",
        "outputId": "705a516b-1e1d-4347-e924-30a48777a893"
      },
      "source": [
        "import numpy as np\n",
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "def engineer_features(df_s):\n",
        "    df = df_s.copy()\n",
        "\n",
        "    # Sort chronologically to preserve time sequence\n",
        "    df = df.sort_values(by=\"departure_time_utc\").reset_index(drop=True)\n",
        "\n",
        "    # Feature Engineering\n",
        "    df[\"route_id\"] = df[\"origin_hub\"].astype(str) + \"_to_\" + df[\"dest_hub\"].astype(str)\n",
        "    df[\"departure_hour\"] = df[\"departure_time_utc\"].dt.hour\n",
        "    df[\"departure_day_of_week\"] = df[\"departure_time_utc\"].dt.dayofweek\n",
        "\n",
        "    # Estimated transit hours promised\n",
        "    df[\"planned_duration_hours\"] = (df[\"promised_arrival_time_utc\"] - df[\"departure_time_utc\"]).dt.total_seconds() / 3600.0\n",
        "\n",
        "    # Select core training features and target variable\n",
        "    features = [\n",
        "        \"origin_hub\",\n",
        "        \"dest_hub\",\n",
        "        \"route_id\",\n",
        "        \"distance_km\",\n",
        "        \"vehicle_type\",\n",
        "        \"departure_hour\",\n",
        "        \"departure_day_of_week\",\n",
        "        \"planned_duration_hours\"\n",
        "    ]\n",
        "\n",
        "    X = df[features]\n",
        "    y = df[\"is_late\"]\n",
        "\n",
        "    return X, y, df[\"departure_time_utc\"]\n",
        "\n",
        "X, y, departure_times = engineer_features(df_shipments_clean)\n",
        "\n",
        "# Time-based split: Use chronological order to prevent leakage\n",
