        "## Part 2: Data Cleaning and Standardization\n",
        "In this step, we will:\n",
        "- Standardize the hub names by merging renamed old hub records into modern ones.\n",
        "- Standardize all timestamps to UTC.\n",
        "- Fix out-of-order scans by ordering events per shipment ID."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 451
        },
        "id": "cd25809f",
        "outputId": "21c2c9be-6f21-44a5-f430-f5feba1a91a8"
      },
      "source": [
        "import pandas as pd\n",
        "\n",
        "def clean_and_standardize(df_s, df_sc):\n",
        "    # 1. Standardize Renamed Hubs\n",
        "    hub_rename_map = {\"Hub_12_Old\": \"Hub_12\"}\n",
        "    df_s_clean = df_s.copy()\n",
        "    df_s_clean[\"origin_hub\"] = df_s_clean[\"origin_hub\"].replace(hub_rename_map)\n",
        "    df_s_clean[\"dest_hub\"] = df_s_clean[\"dest_hub\"].replace(hub_rename_map)\n",
        "\n",
        "    df_sc_clean = df_sc.copy()\n",
        "    df_sc_clean[\"recorded_by\"] = df_sc_clean[\"recorded_by\"].replace(hub_rename_map)\n",
        "\n",
        "    # 2. Standardize Timezones to UTC\n",
        "    # Convert timestamps in df_sc_clean to datetime objects and shift timezone offsets to UTC timezone\n",
        "    df_sc_clean[\"timestamp_utc\"] = pd.to_datetime(df_sc_clean[\"timestamp\"], utc=True)\n",
        "\n",
        "    # Convert departure/arrival times in shipments to UTC (assuming they are generated relative to local timezone)\n",
        "    df_s_clean[\"departure_time_utc\"] = pd.to_datetime(df_s_clean[\"departure_time\"]).dt.tz_localize(\"Asia/Kolkata\", ambiguous=\"NaT\").dt.tz_convert(\"UTC\")\n",
        "    df_s_clean[\"promised_arrival_time_utc\"] = pd.to_datetime(df_s_clean[\"promised_arrival_time\"]).dt.tz_localize(\"Asia/Kolkata\", ambiguous=\"NaT\").dt.tz_convert(\"UTC\")\n",
        "    df_s_clean[\"actual_arrival_time_utc\"] = pd.to_datetime(df_s_clean[\"actual_arrival_time\"]).dt.tz_localize(\"Asia/Kolkata\", ambiguous=\"NaT\").dt.tz_convert(\"UTC\")\n",
        "\n",
        "    # 3. Resolve Out-of-Order Scans by Sorting Chronologically\n",
        "    # Group by shipment_id and sort by standard timestamp_utc\n",
        "    df_sc_clean = df_sc_clean.sort_values(by=[\"shipment_id\", \"timestamp_utc\"]).reset_index(drop=True)\n",
        "\n",
        "    return df_s_clean, df_sc_clean\n",
        "\n",
        "df_shipments_clean, df_scans_clean = clean_and_standardize(df_shipments, df_scans)\n",
        "\n",
        "print(\"Data cleaning complete!\")\n",
        "print(f\"Unique origin hubs after cleaning: {df_shipments_clean['origin_hub'].unique()}\")\n",
        "print(\"Sample of cleaned scan records sorted chronologically:\")\n",
        "display(df_scans_clean.head(6))"
      ],
