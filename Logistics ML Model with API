      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "from datetime import datetime, timedelta\n",
        "\n",
        "# Let's generate a reproducible synthetic shipment and scan dataset containing the specified business challenges.\n",
        "np.random.seed(42)\n",
        "\n",
        "num_shipments = 20000\n",
        "hubs = [f\"Hub_{i}\" for i in range(1, 13)]\n",
        "# Simulate old/new names for one of the hubs (renamed hub challenge)\n",
        "hub_mapping = {\"Hub_12\": \"Hub_12_Old\"}\n",
        "\n",
        "shipments_data = []\n",
        "scans_data = []\n",
        "\n",
        "start_date = datetime(2023, 1, 1)\n",
        "\n",
        "for i in range(num_shipments):\n",
        "    shipment_id = f\"SH_{i:06d}\"\n",
        "    origin = np.random.choice(hubs)\n",
        "    destination = np.random.choice(hubs)\n",
        "    while destination == origin:\n",
        "        destination = np.random.choice(hubs)\n",
        "\n",
        "    # Challenge: Renamed hubs present in raw records\n",
        "    if np.random.rand() < 0.15:\n",
        "        origin = hub_mapping.get(origin, origin)\n",
        "        destination = hub_mapping.get(destination, destination)\n",
        "\n",
        "    # Distances & vehicle types\n",
        "    distance = np.random.uniform(50, 800)\n",
        "    vehicle_type = np.random.choice([\"Reefer_Mini\", \"Reefer_Large\", \"Ambient_Truck\"], p=[0.5, 0.3, 0.2])\n",
        "\n",
        "    # Generate departure timestamp (simulated UTC/local mismatch)\n",
        "    days_offset = np.random.uniform(0, 180)\n",
        "    departure_time = start_date + timedelta(days=days_offset)\n",
        "\n",
        "    # Real duration hours\n",
        "    base_speed = 40.0 # km/h\n",
        "    expected_duration = distance / base_speed\n",
        "    delay_factor = np.random.choice([0.9, 1.0, 1.1, 1.5, 2.0], p=[0.1, 0.5, 0.2, 0.1, 0.1])\n",
        "    actual_duration = expected_duration * delay_factor\n",
        "\n",
        "    # Scheduled and actual arrival\n",
        "    promised_duration = expected_duration * 1.25\n",
        "    scheduled_arrival = departure_time + timedelta(hours=promised_duration)\n",
        "    actual_arrival = departure_time + timedelta(hours=actual_duration)\n",
        "\n",
        "    is_late = int(actual_arrival > scheduled_arrival)\n",
        "\n",
        "    shipments_data.append({\n",
        "        \"shipment_id\": shipment_id,\n",
        "        \"origin_hub\": origin,\n",
        "        \"dest_hub\": destination,\n",
        "        \"distance_km\": distance,\n",
        "        \"vehicle_type\": vehicle_type,\n",
        "        \"departure_time\": departure_time.strftime(\"%Y-%m-%d %H:%M:%S\"),\n",
        "        \"promised_arrival_time\": scheduled_arrival.strftime(\"%Y-%m-%d %H:%M:%S\"),\n",
        "        \"actual_arrival_time\": actual_arrival.strftime(\"%Y-%m-%d %H:%M:%S\"),\n",
        "        \"is_late\": is_late\n",
        "    })\n",
        "\n",
        "    # Challenge: Out-of-order scans and multiple timezones\n",
        "    # We'll create 3 scan events per shipment: Dispatch, Transit, Delivery\n",
        "    scan_events = [\n",
        "        (\"Dispatch\", departure_time + timedelta(minutes=np.random.uniform(-10, 10))),\n",
        "        (\"Transit\", departure_time + timedelta(hours=actual_duration*0.5)),\n",
        "        (\"Delivery\", actual_arrival)\n",
        "    ]\n",
        "\n",
        "    # Scramble scan sequence for some shipments to mimic out-of-order records\n",
        "    if np.random.rand() < 0.10:\n",
        "        scan_events = [scan_events[1], scan_events[0], scan_events[2]]\n",
        "\n",
        "    for event_type, event_time in scan_events:\n",
        "        # Introduce mixed timezones: hub 1-6 in India Standard Time (UTC+5.5), 7-12 logged as UTC\n",
        "        tz_suffix = \"+05:30\" if int(destination.split(\"_\")[1].split(\"_\")[0].replace(\"Old\", \"12\")) <= 6 else \"Z\"\n",
        "        scans_data.append({\n",
        "            \"shipment_id\": shipment_id,\n",
        "            \"event_type\": event_type,\n",
        "            \"timestamp\": event_time.strftime(\"%Y-%m-%d %H:%M:%S\") + tz_suffix,\n",
        "            \"recorded_by\": np.random.choice(hubs)\n",
        "        })\n",
        "\n",
        "df_shipments = pd.DataFrame(shipments_data)\n",
        "df_scans = pd.DataFrame(scans_data)\n",
        "\n",
        "print(f\"Generated {len(df_shipments)} shipments and {len(df_scans)} scans.\")\n",
        "df_shipments.to_csv(\"shipments.csv\", index=False)\n",
        "df_scans.to_csv(\"scans.csv\", index=False)\n",
        "print(\"Saved shipments.csv and scans.csv to workspace.\")"
      ],
