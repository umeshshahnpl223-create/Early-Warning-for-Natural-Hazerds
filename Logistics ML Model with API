        "## Part 6: Randomized Hyperparameter Search & Decision Threshold Optimization\n",
        "To squeeze out the best performance:\n",
        "1. We will use `RandomizedSearchCV` on the XGBoost pipeline to optimize parameters like learning rate, depth, and estimators.\n",
        "2. We will apply a cost-benefit matrix to select a business-optimized classification threshold. Let's assume:\n",
        "   - False Positive (Predicting delay when on-time): Cost of $50 (extra dispatch/notification overhead)\n",
        "   - False Negative (Predicting on-time when delayed): Cost of $250 (critical distributor violation/spoiled cold chain)\n",
        "   - True Positive & True Negative: $0"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "fa5de4e4",
        "outputId": "a6aac5da-1690-47b0-88dd-591e475e71d7"
      },
      "source": [
        "from sklearn.model_selection import RandomizedSearchCV\n",
        "import numpy as np\n",
        "\n",
        "# Get the preprocessor and base estimator\n",
        "xgb_pipeline = Pipeline([\n",
        "    (\"preprocessor\", preprocessor),\n",
        "    (\"classifier\", XGBClassifier(scale_pos_weight=4.0, random_state=42, eval_metric=\"logloss\"))\n",
        "])\n",
        "\n",
        "# Define the search grid\n",
        "param_distributions = {\n",
        "    \"classifier__n_estimators\": [50, 100, 150],\n",
        "    \"classifier__max_depth\": [3, 5, 7],\n",
        "    \"classifier__learning_rate\": [0.01, 0.05, 0.1, 0.2],\n",
        "    \"classifier__subsample\": [0.7, 0.9, 1.0]\n",
        "}\n",
        "\n",
        "# Run Randomized Search\n",
        "random_search = RandomizedSearchCV(\n",
        "    xgb_pipeline,\n",
        "    param_distributions=param_distributions,\n",
        "    n_iter=8,\n",
        "    scoring=\"roc_auc\",\n",
        "    cv=3,\n",
        "    random_state=42,\n",
        "    n_jobs=-1\n",
        ")\n",
        "\n",
        "print(\"Starting randomized search tuning on XGBoost...\")\n",
        "random_search.fit(X_train, y_train)\n",
        "best_pipeline = random_search.best_estimator_\n",
        "print(f\"Best Hyperparameters: {random_search.best_params_}\")\n",
        "\n",
        "# Get best model predictions\n",
        "y_proba = best_pipeline.predict_proba(X_test)[:, 1]\n",
        "\n",
        "# Apply Cost Matrix Optimization\n",
        "# Costs: FN = 250, FP = 50\n",
        "cost_fn = 250.0\n",
        "cost_fp = 50.0\n",
        "\n",
        "thresholds = np.linspace(0.01, 0.99, 100)\n",
        "best_threshold = 0.5\n",
        "min_cost = float(\"inf\")\n",
        "\n",
        "for th in thresholds:\n",
        "    preds = (y_proba >= th).astype(int)\n",
        "    # Calculate Confusion Matrix elements\n",
        "    fn = np.sum((y_test == 1) & (preds == 0))\n",
        "    fp = np.sum((y_test == 0) & (preds == 1))\n",
        "    total_cost = (fn * cost_fn) + (fp * cost_fp)\n",
        "\n",
        "    if total_cost < min_cost:\n",
        "        min_cost = total_cost\n",
        "        best_threshold = th\n",
        "\n",
        "# Final evaluations with custom threshold\n",
        "y_opt_pred = (y_proba >= best_threshold).astype(int)\n",
        "print(f\"\\nBusiness-Optimized Decision Threshold: {best_threshold:.3f}\")\n",
        "print(f\"Total Cost with optimized threshold: ${min_cost:,.2f} (compared to default 0.5 threshold)\")\n",
        "print(\"\\nClassification Report under Optimized Threshold:\")\n",
        "print(classification_report(y_test, y_opt_pred))\n",
        "\n",
        "# Save the final best pipeline\n",
        "joblib.dump(best_pipeline, \"best_logistics_pipeline.pkl\")\n",
        "print(\"Saved the final optimized model pipeline as 'best_logistics_pipeline.pkl'.\")"
      ],
